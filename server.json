{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hanochzhu/codeagent-memory",
  "title": "codeagent-memory",
  "description": "Local code graph and solution memory for coding agents via CLI and MCP.",
  "version": "0.1.2",
  "websiteUrl": "https://github.com/HanochZhu/codeagent_memory",
  "repository": {
    "url": "https://github.com/HanochZhu/codeagent_memory",
    "source": "github",
    "id": "1368492125"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/hanochzhu/codeagent-memory:0.1.2",
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "-i"
        },
        {
          "type": "positional",
          "value": "--rm"
        },
        {
          "type": "positional",
          "value": "-v"
        },
        {
          "type": "positional",
          "valueHint": "workspace_mount",
          "value": "{workspace}:/work",
          "variables": {
            "workspace": {
              "description": "Absolute path of the project directory to index.",
              "format": "filepath",
              "isRequired": true,
              "placeholder": "/path/to/project"
            }
          }
        },
        {
          "type": "positional",
          "value": "-w"
        },
        {
          "type": "positional",
          "value": "/work"
        }
      ]
    }
  ]
}
